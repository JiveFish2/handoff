# Postgres (docker compose up -d db). On Vercel, Neon's pooled connection string.
DATABASE_URL=postgresql://handoff:handoff@localhost:5434/handoff

# The Shopify app (Dev Dashboard → the app → Settings). The secret also verifies webhook
# signatures. SHOPIFY_SHOP is the store's subdomain, without .myshopify.com.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_SHOP=

# The fictional ERP, served by this same app.
ERP_BASE_URL=http://localhost:3002/erp/api
ERP_API_KEY=
