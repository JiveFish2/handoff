{
  "name": "handoff",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3002",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts",
    "webhook": "tsx --env-file=.env.local scripts/send-webhook.ts",
    "shopify:check": "tsx --env-file=.env.local scripts/shopify-check.ts",
    "shopify:products": "tsx --env-file=.env.local scripts/shopify-products.ts",
    "shopify:webhooks": "tsx --env-file=.env.local scripts/shopify-webhooks.ts",
    "shopify:order": "tsx --env-file=.env.local scripts/shopify-order.ts"
  },
  "dependencies": {
    "next": "16.4.0",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
